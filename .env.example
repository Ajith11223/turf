# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/gallant
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/gallant?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gallant

# ---- Auth ----
# Any long random string. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (used only by `npm run seed:admin`) ----
ADMIN_EMAIL=admin@gallant.test
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Site Admin

# ---- Site URL ----
# Used by lib/content.js when it calls the site's own API from the server.
# Leave blank in development; set it in production (e.g. https://yourdomain.com).
NEXT_PUBLIC_SITE_URL=
